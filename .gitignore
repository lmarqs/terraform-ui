# Claude Code worktrees
.claude/worktrees/
# cook:begin io.github.lmarqs.cookbook:git#worktrees/worktrees
# io.github.lmarqs.cookbook:git#worktrees --instructions=AGENTS.md
/.worktrees/*
!/.worktrees/README.md
!/.worktrees/setup
!/.worktrees/teardown
# cook:end io.github.lmarqs.cookbook:git#worktrees/worktrees
# cook:begin io.github.lmarqs.cookbook:agents#connect/harnesses
# io.github.lmarqs.cookbook:agents#connect --harness=claude --harness=codex --worktree-setup=.worktrees/setup --worktree-teardown=.worktrees/teardown --worktree-base=head
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/skills
!/.claude/agents
!/.codex/
/.codex/*
!/.codex/config.toml
!/.codex/hooks.json
!/.codex/rules
!/.codex/agents
