{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.go)|Write(**/*.go)",
            "command": "mise run fmt $CLAUDE_FILE_PATH",
            "timeout": 5,
            "statusMessage": "fmt..."
          },
          {
            "type": "agent",
            "if": "Edit(internal/ui/**)|Write(internal/ui/**)",
            "prompt": "A UI file was just edited. Quickly check: (1) Are keybindings consistent with the project convention (q=back to home, esc=exit sub-state, enter/i=inspect, space=pin, /=filter, r=refresh)? (2) Does the hint text at the bottom match actual keybindings? (3) Are error states handled with an escape route? (4) Hint bar is state-aware (switches on status). Only report ISSUES found, nothing else. If all good, say nothing.",
            "timeout": 15,
            "statusMessage": "TUI quick-check..."
          },
          {
            "type": "agent",
            "if": "Edit(plugins/**)|Write(plugins/**)",
            "prompt": "A plugin file was just edited. Check: (1) Keybindings consistent (q=back, esc=exit sub-state, enter/i=inspect, space=pin, /=filter, r=refresh)? (2) Hint text matches actual keybindings? (3) Error states have escape routes? (4) No import of 'internal/' packages (must use pkg/sdk only)? (5) No direct import of other plugins (use EventBus)? (6) Plugin constructor is `func New(svc sdk.Service) sdk.Plugin`? Only report ISSUES. If all good, say nothing.",
            "timeout": 15,
            "statusMessage": "Plugin quick-check..."
          },
          {
            "type": "agent",
            "if": "Edit(cmd/tfui/**)|Write(cmd/tfui/**)",
            "prompt": "A CLI file was just edited. Check: (1) Data output goes to stdout, progress/status to stderr? (2) No stderr writes in JSON mode paths? (3) Exit codes correct (0=success, 1=error, 2=changes present for plan only)? (4) Error messages lowercase (Go convention)? (5) No 'Press X to Y' patterns? Only report ISSUES. If all good, say nothing.",
            "timeout": 15,
            "statusMessage": "CLI quick-check..."
          },
          {
            "type": "agent",
            "if": "Edit(pkg/sdk/**)|Write(pkg/sdk/**)",
            "prompt": "An SDK file was just edited. Check: (1) If service.go was changed, do ExecService and MacroService still satisfy the interface? Run `mise run check:lint` to verify. (2) If a new event type was added, is there a matching handler interface? (3) If a new optional plugin interface was added, is it documented in .agents/skills/tfui-architecture/SKILL.md? Only report ISSUES. If all good, say nothing.",
            "timeout": 15,
            "statusMessage": "SDK quick-check..."
          }
        ]
      }
    ],
    "Stop": [],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/session-start claude"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/worktree create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/worktree remove"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh auth status *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue list *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label list *)",
      "Bash(gh project field-list *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)",
      "Bash(gh project item-list *)",
      "Bash(gh project list *)",
      "Bash(gh project view *)",
      "Bash(gh repo view *)",
      "Bash(gh run cancel *)",
      "Bash(gh run list *)",
      "Bash(gh run rerun *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh search *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(gotestsum *)",
      "Bash(mise install *)",
      "Bash(mise tasks *)",
      "Bash(mise run build *)",
      "Bash(mise run dev *)",
      "Bash(mise run fmt *)",
      "Bash(mise run setup *)",
      "Bash(mise run check:build *)",
      "Bash(mise run check:lint *)",
      "Bash(mise run test:all *)",
      "Bash(mise run test:coverage *)",
      "Bash(mise run test:integration *)",
      "Bash(mise run test:macro *)",
      "Bash(mise run test:unit *)",
      "Bash(mise run docs:build *)",
      "Bash(mise run docs:check *)",
      "Bash(mise run docs:install *)",
      "Bash(mise run docs:serve *)",
      "Bash(mise run demo:generate *)",
      "Bash(mise run demo:lock *)",
      "Bash(./.worktrees/setup *)"
    ],
    "ask": [],
    "deny": [
      "Bash(git push --force origin main *)",
      "Bash(git push --force origin HEAD:main *)",
      "Bash(git push --force-with-lease origin main *)",
      "Bash(git push --force-with-lease origin HEAD:main *)",
      "Bash(git push -f origin main *)",
      "Bash(git push -f origin HEAD:main *)",
      "Bash(git push origin +main *)",
      "Bash(git push origin +HEAD:main *)",
      "Bash(git push origin main --force*)",
      "Bash(git push origin main -f*)",
      "Bash(git push origin HEAD:main --force*)",
      "Bash(git push origin HEAD:main -f*)",
      "Bash(mise * ::: *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
