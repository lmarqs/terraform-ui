#!/bin/sh
# Usage: session-start <harness>. Runs session-start.d/*.sh in name order with the harness as $1
# and prints their joined output in the envelope that harness reads as session context.
harness=${1:-}
dir=$(dirname -- "$0")/session-start.d
[ -d "$dir" ] || exit 0
text=$(
  LC_ALL=C
  for script in "$dir"/*.sh; do
    [ -f "$script" ] || continue
    sh "$script" "$harness" </dev/null 2>/dev/null
  done
)
[ -n "$text" ] || exit 0
context=$(printf '%s\n' "$text" | LC_ALL=C awk '
BEGIN {
  ORS = ""
  for (i = 1; i < 32; i++) ctl[sprintf("%c", i)] = sprintf("\\u%04x", i)
  ctl["\t"] = "\\t"; ctl["\r"] = "\\r"; ctl["\b"] = "\\b"; ctl["\f"] = "\\f"
  print "\""
}
{
  if (NR > 1) print "\\n"
  out = ""
  n = length($0)
  for (i = 1; i <= n; i++) {
    c = substr($0, i, 1)
    if (c == "\\") out = out "\\\\"
    else if (c == "\"") out = out "\\\""
    else if (c in ctl) out = out ctl[c]
    else out = out c
  }
  print out
}
END { print "\"" }')
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":%s}}\n' "$context"
exit 0
