#!/bin/sh
# Usage: worktree create|remove, with Claude Code's WorktreeCreate or WorktreeRemove input on standard input, or
# worktree prune [--dry-run] [--older-than=<hours>], run by a person or an agent.
# create prints the worktree's path as its last line; everything else goes to standard error.
set -eu

# Rendered by io.github.lmarqs.cookbook:agents#connect from its --worktree-* params. Paths are from the repository
# root; setup, teardown and branch_prefix are empty when not named.
root='.worktrees'
setup='.worktrees/setup'
teardown='.worktrees/teardown'
base='head'
fetch='stale'
remote='origin'
branch_prefix=''
upstream=''
refreshed=false

fail() {
  printf 'worktree: %s\n' "$1" >&2
  shift
  for line in "$@"; do printf '  %s\n' "$line" >&2; done
  exit 1
}

# The string field $1 of the JSON input; names and paths never hold a quote or a backslash, so none is unescaped.
field() {
  printf '%s\n' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"\\\\]*\)\".*/\1/p" | sed -n 1p
}

# Runs the script $2, by its path from the worktree $1's root, from that root, with its output on standard error. A
# script committed on the main checkout's HEAD but missing from the worktree is skipped: the branch predates it.
run_script() {
  if [ ! -e "$1/$2" ] && git -C "$main" cat-file -e "HEAD:$2" 2>/dev/null; then
    printf 'worktree: skipped %s, which this branch predates\n' "$2" >&2
    return 0
  fi
  [ -f "$1/$2" ] || fail "$2 is not in $1" 'a worktree holds only what is committed'
  [ -x "$1/$2" ] || fail "$2 is not executable" "in $1"
  (cd "$1" && "./$2") >&2 || fail "$2 failed" "in $1"
}

# Runs a Git command that may reach the remote for at most ten seconds, failing instead of asking for a password, a
# passphrase or a host key. Its output reaches standard error once it ends, through a file, so an ssh it leaves behind
# holds none of the hook's own output open.
unprompted() {
  log=$(mktemp)
  if [ -z "${GIT_SSH_COMMAND:-}${GIT_SSH:-}" ] && ! git -C "$main" config core.sshCommand >/dev/null; then
    env GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' "$@" </dev/null >"$log" 2>&1 &
  else
    env GIT_TERMINAL_PROMPT=0 "$@" </dev/null >"$log" 2>&1 &
  fi
  pid=$!
  (sleep 10 && kill "$pid") </dev/null >/dev/null 2>&1 &
  watcher=$!
  if wait "$pid"; then status=0; else status=$?; fi
  kill "$watcher" 2>/dev/null || true
  cat "$log" >&2
  rm -f "$log"
  return "$status"
}

# Fetches the remote as $fetch says, stale fetching once its last fetch is a day old, only its default branch once that
# is known, and sets $upstream to the remote's default branch, such as origin/main, or to nothing when it is not known.
# Only the first call in a run fetches.
refresh() {
  [ "$refreshed" = false ] || return 0
  refreshed=true
  git -C "$main" remote get-url "$remote" >/dev/null 2>&1 || return 0
  fetched=$(git -C "$main" rev-parse --absolute-git-dir)/FETCH_HEAD
  reachable=true
  if [ "$fetch" = always ] || { [ "$fetch" = stale ] && [ -z "$(find "$fetched" -mmin -1440 2>/dev/null)" ]; }; then
    known=$(git -C "$main" symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null) || known=''
    if ! unprompted git -C "$main" fetch --quiet "$remote" ${known:+"${known#"$remote"/}"}; then
      printf 'worktree: could not fetch %s, so its branches are as last fetched\n' "$remote" >&2
      reachable=false
    fi
  fi
  if [ "$fetch" != never ] && [ "$reachable" = true ] && ! git -C "$main" symbolic-ref --quiet "refs/remotes/$remote/HEAD" >/dev/null; then
    unprompted git -C "$main" remote set-head "$remote" --auto >/dev/null 2>&1 || true
  fi
  upstream=$(git -C "$main" symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null) || upstream=''
  if [ -n "$upstream" ] && ! git -C "$main" rev-parse --verify --quiet "$upstream^{commit}" >/dev/null; then
    upstream=''
  fi
}

# The file marking the worktree $1 as one this hook created, in the worktree's own Git directory, so it goes with it.
marker() {
  printf '%s/cook-worktree\n' "$(git -C "$1" rev-parse --absolute-git-dir)"
}

# Whether every patch on the branch $1 is on the commit $2, matched by patch, so a rebased or cherry-picked commit
# counts.
landed() {
  [ -n "$2" ] || return 1
  cherry=$(git -C "$main" cherry "$2" "$1") || return 1
  ! printf '%s\n' "$cherry" | grep -q '^+'
}

# Whether every patch on $1 is on the main checkout's HEAD or, fetched as $fetch says only when it is not, on the
# remote's default branch.
landed_anywhere() {
  landed "$1" HEAD || { refresh && landed "$1" "$upstream"; }
}

# The branch create made for the worktree $1: its path under the root, whichever branch it has checked out since; nothing
# for a worktree outside the root.
branch_of() {
  case $1 in
    "$main/$root"/*) printf '%s\n' "${1#"$main/$root"/}" ;;
  esac
}

# Runs the teardown in the worktree $1, which this hook created, removes it, then forgets it.
discard() {
  if [ -n "$teardown" ]; then run_script "$1" "$teardown"; fi
  git -C "$main" worktree remove --force "$1" >&2 || return 1
  forget "$1"
}

# Removes the directories under the root the worktree $1 left empty, and the branch its path names once it landed.
forget() {
  branch=$(branch_of "$1")
  [ -n "$branch" ] || return 0
  parent=$(dirname -- "$1")
  while [ "$parent" != "$main/$root" ] && rmdir -- "$parent" 2>/dev/null; do parent=$(dirname -- "$parent"); done
  git -C "$main" show-ref --verify --quiet "refs/heads/$branch" || return 0
  if landed_anywhere "$branch"; then
    git -C "$main" branch -D "$branch" >&2 ||
      printf 'worktree: kept the branch %s, which Git would not delete\n' "$branch" >&2
  else
    printf 'worktree: kept the branch %s, which has commits on neither HEAD nor %s\n' "$branch" \
      "${upstream:-the default branch of $remote}" >&2
  fi
}

kept() {
  printf 'worktree: kept %s, %s\n' "$1" "$2" >&2
}

# Removes the worktree $1, locked when $2 is true, when this hook created it under the root and it is unlocked, not
# where prune runs, unchanged for $minutes minutes, clean, and checked out at a commit that landed, on a branch that
# landed. Prints why it keeps a worktree it created, and sets $failed when one it would remove stays.
consider() {
  branch=$(branch_of "$1")
  [ -n "$branch" ] && [ -d "$1" ] && [ -e "$(marker "$1")" ] || return 0
  # Each reason returns whether or not it could be printed, so a failing standard error never lets a worktree through.
  if [ "$2" = true ]; then kept "$1" 'which is locked'; return 0; fi
  if [ "$1" = "$here" ]; then kept "$1" 'which holds the current directory'; return 0; fi
  # Untouched files keep their dates, so a worktree in use but without commits or edits yet is told apart by them.
  if [ "$minutes" -gt 0 ]; then
    if ! recent=$(find "$1" "$(git -C "$1" rev-parse --absolute-git-dir)" -mmin "-$minutes" -print -quit 2>/dev/null) &&
      [ -z "$recent" ]; then
      kept "$1" 'whose age find could not read'
      return 0
    fi
    if [ -n "$recent" ]; then kept "$1" "which changed in the last $hours hours"; return 0; fi
  fi
  if ! changes=$(git --no-optional-locks -C "$1" status --porcelain); then
    kept "$1" 'whose status Git could not read'
    return 0
  fi
  if [ -n "$changes" ]; then kept "$1" 'which has uncommitted or untracked files'; return 0; fi
  if ! landed_anywhere "$(git -C "$1" rev-parse --verify --quiet 'HEAD^{commit}')" ||
    { git -C "$main" show-ref --verify --quiet "refs/heads/$branch" && ! landed_anywhere "$branch"; }; then
    kept "$1" "which has commits on neither HEAD nor ${upstream:-the default branch of $remote}"
    return 0
  fi
  if [ "$dry_run" = true ]; then
    printf 'worktree: would remove %s\n' "$1" >&2
  elif (discard "$1"); then
    printf 'worktree: removed %s\n' "$1" >&2
  else
    kept "$1" 'which could not be removed'
    failed=true
  fi
}

usage() {
  echo 'usage: worktree create|remove|prune [--dry-run] [--older-than=<hours>]' >&2
  exit 2
}

[ -n "$root" ] && [ -n "$base" ] && [ -n "$fetch" ] && [ -n "$remote" ] ||
  fail 'the worktree hook has no settings' 'cook io.github.lmarqs.cookbook:agents#connect with a --worktree-* param'
main=$(git -C "$(dirname -- "$0")" worktree list --porcelain | sed -n '1s/^worktree //p')

case ${1:-} in
  create)
    input=$(cat)
    name=$(field name)
    branch=$branch_prefix$name
    [ -n "$name" ] && git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
      fail "${branch:-an empty name} is not a branch name" 'the worktree goes on a branch of the same name'
    worktree=$main/$root/$branch
    if git -C "$main" worktree list --porcelain | grep -qxF "worktree $worktree"; then
      if [ -d "$worktree" ]; then
        [ -e "$(marker "$worktree")" ] || fail "$worktree is a worktree this hook did not create" 'name another'
        printf 'worktree: reusing %s\n' "$worktree" >&2
        printf '%s\n' "$worktree"
        exit 0
      fi
      git -C "$main" worktree prune >&2
    fi
    created=false
    if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$main" worktree add "$worktree" "$branch" >&2
    else
      start=''
      if [ "$base" = head ]; then
        cwd=$(field cwd)
        start=$(git -C "${cwd:-$main}" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null) || start=''
        git -C "$main" cat-file -e "$start^{commit}" 2>/dev/null || start=''
      else
        refresh
        start=$upstream
        [ -n "$start" ] ||
          printf 'worktree: no default branch of %s is known, so %s starts at HEAD\n' "$remote" "$branch" >&2
      fi
      git -C "$main" worktree add --no-track -b "$branch" "$worktree" "${start:-HEAD}" >&2
      created=true
    fi
    : >"$(marker "$worktree")"
    if [ -n "$setup" ] && ! (run_script "$worktree" "$setup"); then
      git -C "$main" worktree remove --force "$worktree" >&2
      if [ "$created" = true ]; then git -C "$main" branch -D "$branch" >&2; fi
      fail "removed the worktree $worktree, whose setup failed"
    fi
    printf '%s\n' "$worktree"
    ;;
  remove)
    input=$(cat)
    worktree=$(field worktree_path)
    [ -n "$worktree" ] || fail 'the input has no worktree_path'
    [ "$worktree" != "$main" ] || fail "$worktree is the main checkout" 'only a linked worktree is removed'
    if [ -d "$worktree" ]; then
      [ -e "$(marker "$worktree")" ] || fail "$worktree is a worktree this hook did not create" 'it is kept'
      [ -z "$(git -C "$worktree" status --porcelain)" ] || fail "$worktree has uncommitted or untracked files" \
        'commit or stash them, or run the teardown and git worktree remove --force by hand'
      discard "$worktree"
    else
      git -C "$main" worktree prune >&2
      forget "$worktree"
    fi
    ;;
  prune)
    shift
    dry_run=false
    hours=24
    for option do
      case $option in
        --dry-run) dry_run=true ;;
        --older-than=*) hours=${option#--older-than=} ;;
        *) usage ;;
      esac
    done
    case $hours in
      '' | *[!0-9]*) fail "--older-than=$hours is not a whole number of hours" 'such as --older-than=24' ;;
    esac
    # Shell arithmetic reads a leading zero as octal and overflows past 64 bits.
    decimal=${hours#"${hours%%[!0]*}"}
    [ "${#decimal}" -le 6 ] || fail "--older-than=$hours is more than 999999 hours" 'such as --older-than=24'
    hours=${decimal:-0}
    minutes=$((hours * 60))
    here=$(git rev-parse --show-toplevel 2>/dev/null) || here=''
    worktrees=$(git -C "$main" worktree list --porcelain)
    failed=false
    worktree=''
    locked=false
    while IFS= read -r line <&3; do
      case $line in
        'worktree '*) worktree=${line#worktree } && locked=false ;;
        locked | 'locked '*) locked=true ;;
        '') [ -z "$worktree" ] || consider "$worktree" "$locked" && worktree='' ;;
      esac
    done 3<<EOF
$worktrees

EOF
    [ "$failed" = false ]
    ;;
  *)
    usage
    ;;
esac
